#!/bin/sh

touch /etc/config/captive-portal

# Create the default service section if it does not exist yet
if ! uci -q get captive-portal.@service[0].daemon >/dev/null 2>&1; then
	uci -q batch <<'EOF'
add captive-portal service
set captive-portal.@service[-1].daemon='opennds'
set captive-portal.@service[-1].interface='lan'
set captive-portal.@service[-1].auth_method='both'
set captive-portal.@service[-1].portal_name='Guest WiFi'
set captive-portal.@service[-1].max_client_time='0'
set captive-portal.@service[-1].gatewayname='CaptivePortal'
set captive-portal.@service[-1].default_upload_limit='0'
set captive-portal.@service[-1].default_download_limit='0'
set captive-portal.@service[-1].default_timeout='1200'
commit captive-portal
EOF
fi

# Create a default guest account if none exists yet
if ! uci -q get captive-portal.@guest[0].username >/dev/null 2>&1; then
	uci -q batch <<'EOF'
add captive-portal guest
set captive-portal.@guest[-1].username='guestuser'
set captive-portal.@guest[-1].password='ph4hhw0rDd'
set captive-portal.@guest[-1].mac=''
set captive-portal.@guest[-1].upload_limit='0'
set captive-portal.@guest[-1].download_limit='0'
set captive-portal.@guest[-1].timeout='1200'
set captive-portal.@guest[-1].auth_method='password'
set captive-portal.@guest[-1].enabled='1'
commit captive-portal
EOF
fi

# Configure openNDS to use this package's assets. openNDS is the sole
# supported captive portal daemon, so there is no other daemon value to
# gate this section on.
if ! uci -q get opennds.@opennds[0] >/dev/null 2>&1; then
	uci -q add opennds opennds >/dev/null
fi

iface=$(uci -q get captive-portal.@service[0].interface)
gatewayname=$(uci -q get captive-portal.@service[0].gatewayname)
timeout=$(uci -q get captive-portal.@service[0].default_timeout)
timeout="${timeout:-1200}"

# openNDS's sessiontimeout is in minutes; our default_timeout is in
# seconds. 0 means "unlimited" and passes through unconverted; any other
# value is rounded up to at least 1 minute.
if [ "$timeout" -eq 0 ] 2>/dev/null; then
	minutes=0
else
	minutes=$((timeout / 60))
	[ "$minutes" -lt 1 ] && minutes=1
fi

# fas_secure_enabled=0 (plain, unverified token) is intentional, not a
# placeholder — fas_auth does not implement openNDS's hid-token
# verification (see CLAUDE.md Key Design Decision #5's "Accepted risk"
# note). Keep this in sync with FAS_SECURE_ENABLED in captive-portal.uc.
uci -q batch <<EOF
set opennds.@opennds[0].enabled='1'
set opennds.@opennds[0].enable_serial_number_suffix='0'
set opennds.@opennds[0].gatewayname='${gatewayname:-CaptivePortal}'
set opennds.@opennds[0].gatewayinterface='${iface:-lan}'
set opennds.@opennds[0].sessiontimeout='${minutes}'
set opennds.@opennds[0].binauth='/usr/lib/captive-portal/binauth.sh'
set opennds.@opennds[0].fasport='2080'
set opennds.@opennds[0].faspath='/splash.html'
set opennds.@opennds[0].fas_secure_enabled='0'
commit opennds
EOF

# openNDS's own pre-auth walled garden (its legacy `ip nds_filter` table,
# managed entirely outside UCI's `firewall` config) only lets guest
# clients reach a hardcoded port list on the router itself (its own
# built-in webserver port, DNS, DHCP, SSH, HTTPS) — NOT our custom FAS
# port, since a locally-hosted FAS isn't openNDS's normal deployment
# model (a real FAS is usually a separate remote server, which never
# needs a router-local firewall exception at all). `users_to_router`
# is openNDS's own supported mechanism for adding to that allowlist.
if ! uci -q get 'opennds.@opennds[0].users_to_router' | grep -q 'port 2080'; then
	uci -q add_list 'opennds.@opennds[0].users_to_router=allow tcp port 2080'
	uci -q commit opennds
fi

# Create the local FAS (Forwarding Authentication Service) listener on
# uhttpd if it does not exist yet. This serves the fas_auth ubus method
# and the static splash assets pre-login on the same port as opennds's
# fasport above.
if ! uci -q get uhttpd.captive_portal_fas >/dev/null 2>&1; then
	# `uci add <config> <type>` creates an ANONYMOUS section (returning an
	# auto-generated name) — it does not create a section named
	# "captive_portal_fas". A NAMED section (so later code/upgrades can
	# keep addressing it by this fixed name) requires `set
	# uhttpd.<name>=<type>` instead.
	uci -q batch <<'EOF'
set uhttpd.captive_portal_fas=uhttpd
set uhttpd.captive_portal_fas.listen_http='0.0.0.0:2080'
set uhttpd.captive_portal_fas.home='/www/captive-portal'
set uhttpd.captive_portal_fas.ubus_prefix='/ubus'
commit uhttpd
EOF
	/etc/init.d/uhttpd restart
fi

# Register with LuCI's apply tracker so Save & Apply restarts the captive-portal service
uci -q set ucitrack.captive_portal=captive-portal
uci -q set ucitrack.captive_portal.init='captive-portal'
uci -q commit ucitrack

# Enable and start the captive-portal service so Save & Apply triggers a daemon reload
if [ -x /etc/init.d/captive-portal ]; then
	/etc/init.d/captive-portal enable
	/etc/init.d/captive-portal start
fi

# Generate the static blocked list used by the splash page
if [ -x /usr/lib/captive-portal/sync-blocked-json.sh ]; then
	/usr/lib/captive-portal/sync-blocked-json.sh
fi

exit 0
